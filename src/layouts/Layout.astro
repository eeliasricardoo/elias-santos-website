---
import "@/styles/global.css";
import ResourceHints from "@/components/performance/ResourceHints.astro";
import PersonSchema from "@/components/seo/PersonSchema.astro";
import { GoogleAnalytics } from "@/components/analytics/GoogleAnalytics";
import { MicrosoftClarity } from "@/components/analytics/MicrosoftClarity";
import { WebVitalsMonitor } from "@/components/performance/WebVitalsMonitor";
interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const {
	title,
	description = "Senior Product Designer and UX Engineer working at the intersection of design and engineering, specializing in design systems, React/Next.js interfaces, interaction design, and production-ready digital products.",
	ogImage = "/oq-image.png",
} = Astro.props;

// Detect the active origin (prefer production Astro.site, fallback to Vercel preview URL or local url)
const activeOrigin = typeof process !== 'undefined' && process.env.VERCEL_ENV === 'preview' && process.env.VERCEL_URL
	? `https://${process.env.VERCEL_URL}`
	: (Astro.site ? Astro.site.origin : Astro.url.origin);

// Canonical URL (fallback to current origin if site not configured)
const canonicalURL = Astro.site
	? new URL(Astro.url.pathname, Astro.site)
	: Astro.url;

// Construct absolute Open Graph image URL
const absoluteOgImage = new URL(ogImage, activeOrigin).href;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />

		<!-- SEO Meta Tags -->
		<meta name="author" content="Elias Ricardo" />
		<meta name="theme-color" content="#0f172a" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteOgImage} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteOgImage} />

		<!-- Resource Hints for Performance -->
		<ResourceHints />

		<!-- JSON-LD SEO Schema -->
		<PersonSchema />

		<!-- Analytics & Performance Monitoring — deferred to idle to avoid blocking LCP/TBT -->
		<GoogleAnalytics client:idle />
		<MicrosoftClarity client:idle />
		<WebVitalsMonitor client:idle />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" type="image/png" href="/favicon.png?v=2" />
		<link rel="alternate icon" type="image/x-icon" href="/favicon.ico?v=2" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-background font-sans antialiased overflow-x-clip overscroll-none">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:font-mono focus:text-xs focus:font-bold focus:rounded-md focus:shadow-2xl focus:outline-none"
		>
			Skip to main content
		</a>
		<slot />
	</body>
</html>
