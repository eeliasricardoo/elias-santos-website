---
import Layout from "@/layouts/Layout.astro";
import { SubpageHeader, PixelFooter } from "@/components/pixel/PixelChrome";
import { Mascot } from "@/components/pixel/Mascot";
import { ProjectStructuredData } from "@/components/seo/ProjectStructuredData";
import {
    RankingHeader,
    RankingIntroduction,
    RankingProblem,
    RankingObjectives,
    RankingResearch,
    RankingInsights,
    RankingPersonas,
    RankingUserJourney,
    RankingSolution,
    RankingTesting,
    RankingAuthor,
    RankingCTA,
} from "@/components/portfolio/ranking";
import { CaseStudyLayout } from "@/components/portfolio/ui/CaseStudyLayout";
import { CaseSummary } from "@/components/portfolio/ui/CaseSummary";
---

<Layout
    title="Ranking App - UX Research Case Study"
    description="Complete case study of the ranking application developed by Elias Ricardo. UX research, personas, user journey and innovative solutions for gamification."
>
    <ProjectStructuredData
        client:load
        name="Ranking Engine"
        description="Complete case study of the ranking application developed by Elias Ricardo. UX research, personas, user journey and innovative solutions for gamification."
        image="/portfolios/ranking/ranking.webp"
        url="/portfolio/ranking"
        technologies={["Gamification", "SSR", "Caching", "UX Research"]}
        category="UX Research Case Study"
        datePublished="2025-08-01"
        author="Elias Ricardo"
    />
    <SubpageHeader client:load current="case" />

    <CaseStudyLayout client:load brand="orange">
        <RankingHeader client:load />

        <CaseSummary project="05" />
        <RankingIntroduction client:visible />
        <RankingProblem client:visible />
        <RankingObjectives client:visible />
        <RankingResearch client:visible />
        <RankingInsights client:visible />
        <RankingPersonas client:visible />
        <RankingUserJourney client:visible />
        <RankingSolution client:visible />
        <RankingTesting client:visible />
        <RankingAuthor client:visible />
        <RankingCTA client:visible />
    </CaseStudyLayout>

    <PixelFooter client:visible />
    <Mascot client:idle />
</Layout>
