---
import Layout from "@/layouts/Layout.astro";
import { Navbar } from "@/components/Navbar";
import { ProjectStructuredData } from "@/components/seo/ProjectStructuredData";
import { CaseStudyLayout } from "@/components/portfolio/ui/CaseStudyLayout";
import {
    HeroSection,
    WhyItExistsSection,
    PersonasSection,
    LandscapeSection,
    JourneySection,
    DesignSystemSection,
    ResultsSection,
    CallToActionSection,
} from "@/components/portfolio/netflix";
import { ProgressIndicator } from "@/components/home/ProgressIndicator";
import { ScrollIndicator } from "@/components/home/ScrollIndicator";
---

<Layout
    title="Streaming Platform — Case Study"
    description="Case study of a high-performance streaming platform built for a real client, designed with a strict focus on UX/UI and accessibility for senior users."
>
    <ProjectStructuredData
        client:load
        name="Streaming Platform"
        description="Case study of a high-performance streaming platform built for a real client, designed with a strict focus on UX/UI and accessibility for senior users."
        image="/portfolios/netflix/hero-featured.jpg"
        url="/portfolio/netflix"
        technologies={["UX Engineering", "Product Design", "Design System", "React 19"]}
        category="UX/UI & Product Design Case Study"
        datePublished="2026-06-17"
        author="Elias Ricardo"
    />
    <Navbar client:load />
    <ProgressIndicator client:load />

    <CaseStudyLayout client:load brand="red">
        <HeroSection client:load />
        <WhyItExistsSection client:visible />
        <PersonasSection client:visible />
        <LandscapeSection client:visible />
        <JourneySection client:visible />
        <DesignSystemSection client:visible />
        <ResultsSection client:visible />
        <CallToActionSection client:visible />
    </CaseStudyLayout>

    <ScrollIndicator client:load />
</Layout>
