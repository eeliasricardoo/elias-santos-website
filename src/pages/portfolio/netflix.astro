---
import Layout from "@/layouts/Layout.astro";
import { SubpageHeader, PixelFooter } from "@/components/pixel/PixelChrome";
import { Mascot } from "@/components/pixel/Mascot";
import { ProjectStructuredData } from "@/components/seo/ProjectStructuredData";
import { CaseStudyLayout } from "@/components/portfolio/ui/CaseStudyLayout";
import { CaseSummary } from "@/components/portfolio/ui/CaseSummary";
import {
    HeroSection,
    ProblemSection,
    RoleSection,
    FlowSection,
    StatesSection,
    SpeedSection,
    AdminSection,
    SystemSection,
    StackSection,
    CallToActionSection,
} from "@/components/portfolio/netflix";
---

<Layout
    title="Streaming Platform — Case Study | Elias Ricardo"
    description="Case study of a subscription streaming platform with 500+ active users, designed and built end to end by one person: user flows, access rules, design system and admin panel."
>
    <ProjectStructuredData
        client:load
        name="Streaming Platform"
        description="Case study of a subscription streaming platform with 500+ active users, designed and built end to end by one person: user flows, access rules, design system and admin panel."
        image="/oq-image.png"
        url="/portfolio/netflix"
        technologies={["UX Engineering", "Product Design", "Design System", "React 19"]}
        category="UX/UI & Product Design Case Study"
        datePublished="2026-06-17"
        author="Elias Ricardo"
    />
    <SubpageHeader client:load current="case" />

    <CaseStudyLayout client:load brand="red">
        <HeroSection client:load />

        <CaseSummary project="03" />
        <ProblemSection client:visible />
        <RoleSection client:visible />
        <FlowSection client:visible />
        <StatesSection client:visible />
        <SpeedSection client:visible />
        <AdminSection client:visible />
        <SystemSection client:visible />
        <StackSection client:visible />
        <CallToActionSection client:visible />
    </CaseStudyLayout>

    <PixelFooter client:visible />
    <Mascot client:idle />
</Layout>
