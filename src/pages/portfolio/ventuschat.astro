---
import Layout from "@/layouts/Layout.astro";
import { Navbar } from "@/components/Navbar";

import { CaseStudyLayout } from "@/components/portfolio/ui/CaseStudyLayout";
import {
    HeroSection,
    IntroductionSection,
    Phase1Section,
    DoubleDiamondSection,
    Phase2Section,
    Phase3Section,
    ResultsSection,
    KeyFeaturesSection,
    Phase4Section,
    CallToActionSection,
} from "@/components/portfolio/ventus";
import { ProgressIndicator } from "@/components/home/ProgressIndicator";
import { ScrollIndicator } from "@/components/home/ScrollIndicator";
---

<Layout
    title="ChatAI - From Need to Innovation in One Week"
    description="Complete case study of ChatAI, a personalized AI tool developed in one week. Innovative solution for AI chat that's cheaper, customizable, and superior to existing workflows."
>
    <Navbar client:load />
    <ProgressIndicator client:load />

    <CaseStudyLayout client:load brand="cyan">
        <HeroSection client:load />

        <IntroductionSection client:visible />

        <Phase1Section client:visible />

        <DoubleDiamondSection client:visible />

        <Phase2Section client:visible />

        <Phase3Section client:visible />

        <ResultsSection client:visible />

        <KeyFeaturesSection client:visible />

        <Phase4Section client:visible />

        <CallToActionSection client:visible />
    </CaseStudyLayout>

    <ScrollIndicator client:load />
</Layout>
