---
import Layout from "@/layouts/Layout.astro";
import { SubpageHeader, PixelFooter } from "@/components/pixel/PixelChrome";
import { Mascot } from "@/components/pixel/Mascot";
import { ProjectStructuredData } from "@/components/seo/ProjectStructuredData";

import { CaseStudyLayout } from "@/components/portfolio/ui/CaseStudyLayout";
import { CaseSummary } from "@/components/portfolio/ui/CaseSummary";
import {
    HeroSection,
    IntroductionSection,
    Phase1Section,
    DoubleDiamondSection,
    Phase2Section,
    Phase3Section,
    ResultsSection,
    KeyFeaturesSection,
    Phase4Section,
    CallToActionSection,
} from "@/components/portfolio/ventus";
---

<Layout
    title="ChatAI - From Need to Innovation in One Week"
    description="Complete case study of ChatAI, a personalized AI tool developed in one week. Innovative solution for AI chat that's cheaper, customizable, and superior to existing workflows."
>
    <ProjectStructuredData
        client:load
        name="ChatAI"
        description="Complete case study of ChatAI, a personalized AI tool developed in one week. Innovative solution for AI chat that's cheaper, customizable, and superior to existing workflows."
        image="/portfolios/ventus/v9.webp"
        url="/portfolio/ventuschat"
        technologies={["Next.js", "AI", "Streaming", "Multimodal"]}
        category="UX Engineering & Frontend Case Study"
        datePublished="2025-08-01"
        author="Elias Ricardo"
    />
    <SubpageHeader client:load current="case" />

    <CaseStudyLayout client:load brand="cyan">
        <HeroSection client:load />

        <CaseSummary project="06" />

        <IntroductionSection client:visible />

        <Phase1Section client:visible />

        <DoubleDiamondSection client:visible />

        <Phase2Section client:visible />

        <Phase3Section client:visible />

        <ResultsSection client:visible />

        <KeyFeaturesSection client:visible />

        <Phase4Section client:visible />

        <CallToActionSection client:visible />
    </CaseStudyLayout>

    <PixelFooter client:visible />
    <Mascot client:idle />
</Layout>
