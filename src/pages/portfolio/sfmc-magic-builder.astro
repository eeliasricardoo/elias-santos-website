---
import Layout from "@/layouts/Layout.astro";
import { Navbar } from "@/components/Navbar";
import { ProjectStructuredData } from "@/components/seo/ProjectStructuredData";
import { CaseStudyLayout } from "@/components/portfolio/ui/CaseStudyLayout";
import {
    HeroSection,
    PhilosophySection,
    AudienceSection,
    RoleSection,
    ConflictSection,
    JourneySection,
    ValidationSection,
    ProductAnalysisSection,
    ResultsSection,
    ConclusionSection,
    CallToActionSection,
} from "@/components/portfolio/sfmc-magic-builder";
import { ProgressIndicator } from "@/components/home/ProgressIndicator";
import { ScrollIndicator } from "@/components/home/ScrollIndicator";
---

<Layout
    title="EmailFlow Pro | Elias Ricardo"
    description="EmailFlow Pro case study: workflow analysis, product design, React implementation, and AI-assisted development reduced campaign build time from about 80 minutes to 10–20."
>
    <ProjectStructuredData
        client:load
        name="EmailFlow Pro"
        description="EmailFlow Pro case study: workflow analysis, product design, React implementation, and AI-assisted development reduced campaign build time from about 80 minutes to 10–20."
        image="/portfolios/sfmc-magic-builder/interface-top.webp"
        url="/portfolio/sfmc-magic-builder"
        technologies={["React", "AI", "UX Engineering", "Salesforce Marketing Cloud"]}
        category="UX Engineering & Product Design Case Study"
        datePublished="2025-08-01"
        author="Elias Ricardo"
    />
    <Navbar client:load />
    <ProgressIndicator client:load />

    <CaseStudyLayout client:load brand="violet">
        <HeroSection client:load />

        <PhilosophySection client:visible />

        <AudienceSection client:visible />

        <RoleSection client:visible />

        <ConflictSection client:visible />

        <JourneySection client:visible />

        <ValidationSection client:visible />

        <ProductAnalysisSection client:visible />

        <ResultsSection client:visible />

        <ConclusionSection client:visible />

        <CallToActionSection client:visible />
    </CaseStudyLayout>

    <ScrollIndicator client:load />
</Layout>
