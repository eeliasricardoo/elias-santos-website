---
import Layout from "@/layouts/Layout.astro";
import { BackButton } from "@/components/portfolio/ui/BackButton";
import { CaseStudyLayout } from "@/components/portfolio/ui/CaseStudyLayout";
import {
    HeroSection,
    IntroductionSection,
    ProblemSection,
    SolutionSection,
    DevelopmentJourneySection,
    DetailedPhasesSection,
    FeaturesSection,
    ResultsSection,
    CallToActionSection,
} from "@/components/portfolio/carousel-builder";
import { ProgressIndicator } from "@/components/home/ProgressIndicator";
import { ScrollIndicator } from "@/components/home/ScrollIndicator";
---

<Layout
    title="Post & Carousel Generator - Case Study"
    description="Complete case study of Post & Carousel Generator, an AI tool that revolutionizes carousel creation for social media. 90% reduction in creation time."
>
    <ProgressIndicator client:load />

    <CaseStudyLayout>
        <!-- Hero Section -->
        <HeroSection client:load />

        <!-- Introduction -->
        <IntroductionSection client:visible />

        <!-- The Problem -->
        <ProblemSection client:visible />

        <!-- The Solution -->
        <SolutionSection client:visible />

        <!-- Development Journey -->
        <DevelopmentJourneySection client:visible />

        <!-- Detailed Phases -->
        <DetailedPhasesSection client:visible />

        <!-- Key Features -->
        <FeaturesSection client:visible />

        <!-- Results & Impact -->
        <ResultsSection client:visible />

        <!-- Call to Action -->
        <CallToActionSection client:visible />
    </CaseStudyLayout>

    <ScrollIndicator client:load />
</Layout>
