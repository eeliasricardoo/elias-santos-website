---
import Layout from "@/layouts/Layout.astro";
import { Navbar } from "@/components/Navbar";
import { ProjectStructuredData } from "@/components/seo/ProjectStructuredData";

import { CaseStudyLayout } from "@/components/portfolio/ui/CaseStudyLayout";
import {
    HeroSection,
    WhyItExistsSection,
    PersonasSection,
    LandscapeSection,
    JourneySection,
    HowItWorksSection,
    RoomSection,
    TrailSection,
    TeacherSideSection,
    UnderTheHoodSection,
    DecisionsSection,
    DesignSystemSection,
    HowItWasBuiltSection,
    CallToActionSection,
} from "@/components/portfolio/ilevar";
import { ProgressIndicator } from "@/components/home/ProgressIndicator";
import { ScrollIndicator } from "@/components/home/ScrollIndicator";
---

<Layout
    title="ilevar — Case Study"
    description="Case study of ilevar: a unified live classroom for language learning that keeps students focused and reduces context switching, designed from tokens to live WebRTC surfaces."
>
    <ProjectStructuredData
        client:load
        name="ilevar"
        description="Case study of ilevar: a unified live classroom for language learning that keeps students focused and reduces context switching, designed from tokens to live WebRTC surfaces."
        image="/placeholder.jpg"
        url="/portfolio/ilevar"
        technologies={["Next.js 16", "WebRTC", "UX Engineering", "UI Library"]}
        category="UX/UI Design Case Study"
        datePublished="2025-08-01"
        author="Elias Ricardo"
    />
    <Navbar client:load />
    <ProgressIndicator client:load />

    <CaseStudyLayout client:load brand="lime">
        <HeroSection client:load />
        <WhyItExistsSection client:visible />
        <PersonasSection client:visible />
        <LandscapeSection client:visible />
        <JourneySection client:visible />
        <HowItWorksSection client:visible />
        <RoomSection client:visible />
        <TrailSection client:visible />
        <TeacherSideSection client:visible />
        <UnderTheHoodSection client:visible />
        <DecisionsSection client:visible />
        <DesignSystemSection client:visible />
        <HowItWasBuiltSection client:visible />
        <CallToActionSection client:visible />
    </CaseStudyLayout>

    <ScrollIndicator client:load />
</Layout>
