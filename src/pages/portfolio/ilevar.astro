---
import Layout from "@/layouts/Layout.astro";
import { SubpageHeader, PixelFooter } from "@/components/pixel/PixelChrome";
import { Mascot } from "@/components/pixel/Mascot";
import { ProjectStructuredData } from "@/components/seo/ProjectStructuredData";

import { CaseStudyLayout } from "@/components/portfolio/ui/CaseStudyLayout";
import { CaseSummary } from "@/components/portfolio/ui/CaseSummary";
import {
    HeroSection,
    ProblemSection,
    RoleSection,
    FlowSection,
    StatesSection,
    AiSection,
    FigmaSection,
    BuildSection,
    SupportSection,
    ClaritySection,
    StackSection,
    CallToActionSection,
} from "@/components/portfolio/ilevar";
---

<Layout
    title="ilevar — UX Engineering Case Study | Elias Ricardo"
    description="ilevar case study: a platform for language schools and teachers, designed in Figma, built in Next.js and supported by the same UX Engineer — design system, live classroom, in-product support and Clarity."
>
    <ProjectStructuredData
        client:load
        name="ilevar"
        description="ilevar case study: a platform for language schools and teachers, designed in Figma, built in Next.js and supported by the same UX Engineer — design system, live classroom, in-product support and Clarity."
        image="/portfolios/ilevar/dashboard.webp"
        url="/portfolio/ilevar"
        technologies={["UX Engineering", "Figma", "Design Systems", "Next.js 16", "WebRTC", "Microsoft Clarity"]}
        category="UX Engineering & Product Design Case Study"
        datePublished="2026-10-12"
        author="Elias Ricardo"
    />
    <SubpageHeader client:load current="case" />

    <CaseStudyLayout client:load brand="lime">
        <HeroSection client:load />

        <CaseSummary project="02" />
        <ProblemSection client:visible />
        <RoleSection client:visible />
        <FlowSection client:visible />
        <StatesSection client:visible />
        <AiSection client:visible />
        <FigmaSection client:visible />
        <BuildSection client:visible />
        <SupportSection client:visible />
        <ClaritySection client:visible />
        <StackSection client:visible />
        <CallToActionSection client:visible />
    </CaseStudyLayout>

    <PixelFooter client:visible />
    <Mascot client:idle />
</Layout>
