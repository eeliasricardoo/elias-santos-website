---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "@/components/Navbar";
import HeroSection from "@/components/home/hero/HeroSection.astro";

import { ProjectsSection } from "@/components/home/projects/ProjectsSection";
import { HowIWorkSection } from "@/components/home/how-i-work/HowIWorkSection";
import { StatsStrip } from "@/components/home/StatsStrip";
import { AboutTerminal } from "@/components/home/about/AboutTerminal";
import { TestimonialsSection } from "@/components/home/testimonials/TestimonialsSection";
import { GetInTouch } from "@/components/home/get-in-touch/GetInTouch";
import { Footer } from "@/components/Footer";
---

<Layout title="Elias Ricardo — Senior UX Engineer">
	<Navbar client:load />

	<main class="relative min-h-screen">
		<HeroSection />
		<StatsStrip client:visible />
		<AboutTerminal client:visible />

		<HowIWorkSection client:visible />
		<ProjectsSection client:visible />
		<TestimonialsSection client:visible />
		<GetInTouch client:visible />
	</main>

	<Footer client:visible />
</Layout>
