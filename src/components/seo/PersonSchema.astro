---
interface Props {
    name?: string;
    jobTitle?: string;
    url?: string;
    image?: string;
    description?: string;
    sameAs?: string[];
    knowsAbout?: string[];
}

const {
    name = "Elias Ricardo",
    jobTitle = "UX/UI Designer & Frontend Developer",
    url = "https://eliasricardo.com",
    image = "https://eliasricardo.com/profile-photo.webp",
    description = "UX/UI Designer and Frontend Developer specialized in building high-performance, beautiful web applications with React, Astro, and TailwindCSS.",
    sameAs = [
        "https://www.linkedin.com/in/eeliasricardo/",
        "https://github.com/eeliasricardo",
    ],
    knowsAbout = [
        "UX Design",
        "UI Design",
        "Frontend Development",
        "React",
        "Astro",
        "TailwindCSS",
        "TypeScript",
        "Figma",
        "Game Design",
    ],
} = Astro.props;

const schema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: name,
    jobTitle: jobTitle,
    url: url,
    image: image,
    description: description,
    sameAs: sameAs,
    knowsAbout: knowsAbout,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
