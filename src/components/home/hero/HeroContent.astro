---
import { HERO_CONTENT } from '@/constants/content';
import { HeroSounds } from './HeroSounds';
---

<div class="relative z-10 space-y-7 text-left">

  <!-- Headline -->
  <div class="flex flex-col gap-0">
    <div class="overflow-hidden">
      <span
        class="hero-slide-up block font-bold uppercase leading-[0.9] tracking-tight text-muted-foreground"
        style="font-size:clamp(40px,8vw,64px);--delay:0.1s"
      >
        {HERO_CONTENT.headline.line1}
      </span>
    </div>
    <div class="overflow-hidden">
      <span
        class="hero-slide-up block font-bold uppercase leading-[0.85] text-stroke"
        style="font-size:clamp(68px,16vw,140px);letter-spacing:0.02em;--delay:0.22s"
      >
        {HERO_CONTENT.headline.line2}<span class="hero-cursor" style="color:currentColor;-webkit-text-stroke:0">_</span>
      </span>
    </div>
  </div>

  <!-- CTAs -->
  <div class="hero-fade-in flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-1" style="--delay:0.8s">
    <a
      href={HERO_CONTENT.cta.primary.href}
      data-hero-cta
      class="w-full sm:w-auto justify-center inline-flex items-center gap-2 h-12 rounded-xl px-8 text-base font-semibold bg-[#faf9f5] light:bg-[#09090b] text-[#09090b] light:text-[#faf9f5] border border-[#e4e4e7] light:border-[#27272a] shadow-[0_3px_0_0_#a1a1aa] light:shadow-[0_3px_0_0_#27272a] transition-all duration-200 hover:bg-[#f4f4f5] light:hover:bg-[#27272a] active:translate-y-[2px] active:shadow-[0_1px_0_0_#a1a1aa] light:active:shadow-[0_1px_0_0_#27272a]"
    >
      {HERO_CONTENT.cta.primary.text}
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </a>

    <a
      href={HERO_CONTENT.cta.secondary.href}
      data-hero-cta
      target="_blank"
      rel="noopener noreferrer"
      class="w-full sm:w-auto justify-center inline-flex items-center h-12 rounded-xl px-8 text-base border border-border transition-all duration-200 active:translate-y-[1px]"
    >
      {HERO_CONTENT.cta.secondary.text}
    </a>
  </div>
</div>

<!-- Retro sounds attached after idle — zero impact on LCP -->
<HeroSounds client:idle />

<style>
  /* fill-mode:both applies the `from` keyframe during the delay period,
     keeping elements hidden until their staggered entrance fires.
     Elements with no animation remain fully visible (no-JS / reduced-motion). */
  .hero-fade-in {
    animation: hero-fade-up 0.6s cubic-bezier(0.16,1,0.3,1) var(--delay, 0s) both;
  }

  .hero-slide-up {
    display: block;
    animation: hero-slide 0.8s cubic-bezier(0.16,1,0.3,1) var(--delay, 0s) both;
  }

  .hero-cursor {
    animation: cursor-blink 1s step-end infinite;
  }

  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes hero-slide {
    from { transform: translateY(110%); }
    to   { transform: translateY(0); }
  }

  @keyframes cursor-blink {
    0%, 50%  { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade-in, .hero-slide-up { animation: none; }
  }
</style>
