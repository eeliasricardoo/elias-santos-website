---
import HeroPhoto from './HeroPhoto.astro';
import HeroContent from './HeroContent.astro';
import { SkillsTicker } from './SkillsTicker';
---

<section class="relative min-h-[calc(100vh-40px)] flex flex-col overflow-hidden">
  <!-- Dot grid background -->
  <div class="absolute inset-0 bg-dot-grid pointer-events-none" />

  <!-- Main content -->
  <div class="relative z-10 flex-1 flex items-center lg:translate-y-8">
    <div class="w-full max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1fr_440px] gap-8 lg:gap-16 items-center lg:min-h-[calc(100vh-40px)] pt-8 pb-12 sm:py-20 lg:py-0">
        <HeroContent />
        <HeroPhoto />
      </div>
    </div>
  </div>

  <!-- Skills ticker at the bottom -->
  <SkillsTicker client:idle />
</section>
